# Copie para .env e ajuste.
# Porta do banco no computador (docker-compose). Precisa ser a mesma da DATABASE_URL.
DB_PORTA=5433
DATABASE_URL="postgresql://vasnutri:vasnutri@localhost:5433/vasnutri"

# Primeiro administrador, criado pelo `npm run db:seed` (senha com 10+ caracteres).
ADMIN_NOME="Administrador"
ADMIN_EMAIL="admin@vasnutri.local"
ADMIN_SENHA="troque-esta-senha"
